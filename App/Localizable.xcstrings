    "export.deleteConfirmAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Continue to Photos deletion confirmation" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "继续至系统照片删除确认" } }
      }
    },
    "export.deleteConfirmCount": {

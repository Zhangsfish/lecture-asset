      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Checking archive and Photos…" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在核对归档和相册…" } }
      }
    },
    "export.errorPurge": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Photos deletion succeeded, but App file cleanup failed. Retry App cleanup; do not delete Photos again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "相册删除已成功，但 App 文件清理失败。请重试清理 App 文件，不要再次删除相册。" } }
      }
    }
  },
  "version": "1.0"
}

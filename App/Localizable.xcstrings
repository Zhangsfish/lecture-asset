    "export.cleanupLockedHint": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Deleting photos stays locked until the complete ZIP is shared, you confirm its external save, and the archive and exact photos pass validation." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "完整 ZIP 分享成功、你确认外部保存，且归档和精确照片集合重新校验通过后，才能删除原照片。" } }
      }
    },
    "export.deleteConfirmTitle": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Delete these exact source photos now?" } },

{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture Asset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讲座照片整理"
          }
        }
      }
    },
    "permission.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full photo access required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要完整照片权限"
          }
        }
      }
    },
    "permission.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and select lecture photos from your library. Full Read & Write access is required for this workflow. This version only selects photos and never modifies them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览并选择相册中的讲座照片。此流程需要完整的读取与写入权限。本版本只选择照片，不会修改照片。"
          }
        }
      }
    },
    "permission.allow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow full access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许完整访问"
          }
        }
      }
    },
    "permission.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limited or denied access blocks selection. Grant Full Access in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受限或拒绝权限时无法选择照片。请在设置中授予完整访问权限。"
          }
        }
      }
    },
    "permission.restricted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is restricted on this device. Check device or family restrictions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备限制了照片访问。请检查设备或家庭限制。"
          }
        }
      }
    },
    "permission.settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "selection.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择"
          }
        }
      }
    },
    "selection.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to select. Press briefly, then drag to sweep; hold near an edge to scroll."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按选择；短按后拖动可连续扫选，停在边缘可滚动。"
          }
        }
      }
    },
    "selection.unselected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择"
          }
        }
      }
    },
    "selection.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认选择"
          }
        }
      }
    },
    "selection.limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum 200 photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多选择 200 张"
          }
        }
      }
    },
    "confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查已选照片"
          }
        }
      }
    },
    "confirm.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are ordered by capture time. Tap any mistaken selection to remove it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片按拍摄时间排序。点按误选照片即可移除。"
          }
        }
      }
    },
    "confirm.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove selected photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已选照片"
          }
        }
      }
    },
    "confirm.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Processing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始整理"
          }
        }
      }
    },
    "confirm.startFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start. Check full Photos access and available storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始。请检查完整照片权限和可用存储空间。"
          }
        }
      }
    },
    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "common.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "processing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理照片"
          }
        }
      }
    },
    "processing.active": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中"
          }
        }
      }
    },
    "processing.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        }
      }
    },
    "processing.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单页处理失败"
          }
        }
      }
    },
    "processing.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理完成"
          }
        }
      }
    },
    "processing.current": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前页"
          }
        }
      }
    },
    "processing.page": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第"
          }
        }
      }
    },
    "processing.liveStill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo still"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实况照片静态图"
          }
        }
      }
    },
    "processing.pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause after this page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理完本页后暂停"
          }
        }
      }
    },
    "processing.pausePending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause requested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将暂停"
          }
        }
      }
    },
    "processing.resume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续处理"
          }
        }
      }
    },
    "processing.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry this page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试本页"
          }
        }
      }
    },
    "processing.removeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove failed page from job"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从任务移除失败页"
          }
        }
      }
    },
    "processing.removeConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this page from the job? The photo stays in Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本次任务移除此页？相册中的照片不会被删除。"
          }
        }
      }
    },
    "processing.notDownloaded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-quality photo is not on this iPhone. Download it in Photos, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上没有全质量照片。请先在“照片”中下载，再重试。"
          }
        }
      }
    },
    "processing.permissionLost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Photos access was lost. Restore it in Settings, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整照片权限已失效。请在设置中恢复后重试。"
          }
        }
      }
    },
    "processing.assetUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is no longer available in Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片已无法从相册获取。"
          }
        }
      }
    },
    "processing.degraded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos returned a preview instead of full quality. Retry after downloading the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片系统仅返回预览，未返回全质量图片。请下载原图后重试。"
          }
        }
      }
    },
    "processing.checkpointInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved JPEG did not pass its size, dimensions, or SHA-256 check. Retry this page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 JPEG 未通过大小、尺寸或 SHA-256 检查。请重试本页。"
          }
        }
      }
    },
    "processing.pageFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create this full-quality JPEG. Retry; no page was skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成本页全质量 JPEG。请重试；没有跳过此页。"
          }
        }
      }
    },
    "processing.storageFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save or restore the job checkpoint. Check device storage before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存或恢复任务检查点。继续前请检查设备存储空间。"
          }
        }
      }
    },
    "processing.retryCheckpoint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry saving checkpoint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试保存检查点"
          }
        }
      }
    },
    "processing.completeDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All static JPEG pages are complete. Build the AI archive and PDF when ready. Sharing and photo deletion are not in this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有静态 JPEG 页面已完成。可继续生成 AI 归档和 PDF；本版本尚无分享和照片删除。"
          }
        }
      }
    },
    "processing.copyMetrics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy safe page measurements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制安全的页面测量数据"
          }
        }
      }
    },
    "processing.copied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurements copied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量数据已复制"
          }
        }
      }
    },
    "processing.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect JPEG"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 JPEG"
          }
        }
      }
    },
    "processing.jpegCount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG 文件"
          }
        }
      }
    },
    "processing.motionCount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOV/audio files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOV/音频文件"
          }
        }
      }
    },
    "archive.paused": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "归档已暂停",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Archive paused",
            "state": "translated"
          }
        }
      }
    },
    "archive.failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "归档失败",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Archive failed",
            "state": "translated"
          }
        }
      }
    },
    "archive.previewPDF": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "查看 PDF",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Inspect PDF",
            "state": "translated"
          }
        }
      }
    },
    "archive.retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "重试归档",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Retry archive",
            "state": "translated"
          }
        }
      }
    },
    "archive.ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "归档和 PDF 已就绪",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Archive and PDF ready",
            "state": "translated"
          }
        }
      }
    },
    "archive.processing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "正在生成归档",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Building archive",
            "state": "translated"
          }
        }
      }
    },
    "archive.readyDetail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "已验证的 AI ZIP 和配套 PDF 暂存于本 App。后续阶段才会提供分享。",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Validated AI ZIP and companion PDF are stored privately in this app. Sharing comes in a later stage.",
            "state": "translated"
          }
        }
      }
    },
    "archive.copyMetrics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "复制安全的归档测量数据",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Copy safe archive measurements",
            "state": "translated"
          }
        }
      }
    },
    "archive.start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "生成 AI 归档和 PDF",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Build AI archive and PDF",
            "state": "translated"
          }
        }
      }
    },
    "archive.resume": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "继续归档",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "Resume archive",
            "state": "translated"
          }
        }
      }
    },
    "archive.failedDetail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "value": "归档未标记为就绪。请检查存储空间后重试；相册照片未被修改。",
            "state": "translated"
          }
        },
        "en": {
          "stringUnit": {
            "value": "The archive was not marked ready. Check storage, then retry. Photos are unchanged.",
            "state": "translated"
          }
        }
      }
    }
  },
  "version": "1.0"
}

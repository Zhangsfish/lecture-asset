    "about.privacyTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私说明"
          }
        }
      }
    },
    "about.privacyLocal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, text recognition and file creation stay on this iPhone. The developer does not automatically receive your photos or text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、文字识别和文件生成在本机完成；开发者不会自动收到你的照片或文字。"
          }
        }
      }
    },
    "about.privacyShare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing, email and the external homepage open only when you choose them. Their receiving services have separate privacy policies; no photos, OCR or diagnostics are attached to support emails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享、邮件和外部主页只在你主动点击时打开，接收方有自己的隐私政策；支持邮件不会自动附加照片、OCR 或诊断。"
          }
        }
      }
    },
    "about.privacyDelete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo deletion needs a verified ZIP, reported share completion, your external-save confirmation, a fresh delete action and system confirmation. App-only cleanup keeps Photos but removes unsaved work. Recently Deleted is never emptied by this App."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除原照片需要 ZIP 校验、分享完成、外部保存确认、单独删除操作和系统确认。仅清除 App 文件会保留相册原件，但丢失未保存的工作文件。App 不清空“最近删除”。"
          }
        }
      }
    },
    "about.privacyLive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos are archived as still JPEGs only. Motion and sound are not kept; deleting the source removes the whole Live Photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo 仅归档静态 JPEG，不保存动态和声音；删除原照片会删除整张 Live Photo。"
          }
        }
      }
    },

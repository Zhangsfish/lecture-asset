{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture Asset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讲座照片整理"
          }
        }
      }
    },
    "permission.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full photo access required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要完整照片权限"
          }
        }
      }
    },
    "permission.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow full access to select and later clean up this batch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许完整访问，用于选择和清理本批照片。"
          }
        }
      }
    },
    "permission.allow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow full access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许完整访问"
          }
        }
      }
    },
    "permission.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Full Access in Settings to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中开启完整访问。"
          }
        }
      }
    },
    "permission.restricted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is restricted on this device. Check device or family restrictions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备限制了照片访问。请检查设备或家庭限制。"
          }
        }
      }
    },
    "permission.settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "selection.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择"
          }
        }
      }
    },
    "selection.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to select; press and drag to sweep, up to 200 photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按选择；长按并滑动可连续选择，最多 200 张"
          }
        }
      }
    },
    "selection.unselected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择"
          }
        }
      }
    },
    "selection.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: Review photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步：检查照片"
          }
        }
      }
    },
    "selection.limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum 200 photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多选择 200 张"
          }
        }
      }
    },
    "confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查已选照片"
          }
        }
      }
    },
    "confirm.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture-time order. Tap to remove a mistake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按拍摄时间排序，点按移除误选"
          }
        }
      }
    },
    "confirm.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove selected photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已选照片"
          }
        }
      }
    },
    "confirm.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Processing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始整理"
          }
        }
      }
    },
    "confirm.startFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start. Check full Photos access and available storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始。请检查完整照片权限和可用存储空间。"
          }
        }
      }
    },
    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "common.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "processing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理照片"
          }
        }
      }
    },
    "processing.active": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中"
          }
        }
      }
    },
    "processing.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        }
      }
    },
    "processing.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单页处理失败"
          }
        }
      }
    },
    "processing.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos prepared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片已整理"
          }
        }
      }
    },
    "processing.current": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前页"
          }
        }
      }
    },
    "processing.page": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第"
          }
        }
      }
    },
    "processing.liveStill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo still"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实况照片静态图"
          }
        }
      }
    },
    "processing.pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause after this page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理完本页后暂停"
          }
        }
      }
    },
    "processing.pausePending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause requested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将暂停"
          }
        }
      }
    },
    "processing.resume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续处理"
          }
        }
      }
    },
    "processing.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry this page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试本页"
          }
        }
      }
    },
    "processing.removeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove failed page from job"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从任务移除失败页"
          }
        }
      }
    },
    "processing.removeConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this page from the job? The photo stays in Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本次任务移除此页？相册中的照片不会被删除。"
          }
        }
      }
    },
    "processing.notDownloaded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-quality photo is not on this iPhone. Download it in Photos, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上没有全质量照片。请先在“照片”中下载，再重试。"
          }
        }
      }
    },
    "processing.permissionLost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Photos access was lost. Restore it in Settings, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整照片权限已失效。请在设置中恢复后重试。"
          }
        }
      }
    },
    "processing.assetUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is no longer available in Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片已无法从相册获取。"
          }
        }
      }
    },
    "processing.degraded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos returned a preview instead of full quality. Retry after downloading the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片系统仅返回预览，未返回全质量图片。请下载原图后重试。"
          }
        }
      }
    },
    "processing.checkpointInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved photo page failed verification. Retry this page; no photo was deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的照片页面未通过校验。请重试本页；相册照片未被删除。"
          }
        }
      }
    },
    "processing.pageFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create this full-quality JPEG. Retry; no page was skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成本页全质量 JPEG。请重试；没有跳过此页。"
          }
        }
      }
    },
    "processing.storageFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save or restore the job checkpoint. Check device storage before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存或恢复任务检查点。继续前请检查设备存储空间。"
          }
        }
      }
    },
    "processing.retryCheckpoint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry saving checkpoint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试保存检查点"
          }
        }
      }
    },
    "processing.completeDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, generate ZIP and PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步生成 ZIP 和 PDF"
          }
        }
      }
    },
    "processing.copyMetrics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy safe page measurements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制安全的页面测量数据"

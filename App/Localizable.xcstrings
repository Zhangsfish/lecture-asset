      }
    },
    "export.deleteLiveWarning": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Live Photos among them: their motion and sound are not archived. Count:" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "其中 Live Photo 的动态与声音没有归档。数量：" } }
      }
    },
    "export.deleteICloudWarning": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "If iCloud Photos is on, deletion may sync to your other devices. Photos will show its own deletion confirmation. Recently Deleted is not emptied here." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "如果已开启 iCloud 照片，删除可能同步到其他设备。系统会再次询问是否删除；本 App 不会清空“最近删除”。" } }
      }
    },
    "export.discardWorkCopy": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Discard App work copy without deleting Photos" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "只删除 App 工作副本，不删除相册照片" } }
      }
    },
    "export.discardConfirmTitle": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Discard this App work copy?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "确定删除本次 App 工作副本吗？" } }
      }
    },
    "export.discardConfirmAction": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Discard App files only" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "只删除 App 文件" } }
      }
    },
    "export.discardDetail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This removes this job's JPEGs, OCR, ZIP, PDF and recovery state from the App. Photos are not changed. You cannot resume this job." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会删除本次任务在 App 中的 JPEG、OCR、ZIP、PDF 和恢复状态；相册照片不会改变，此任务无法再恢复。" } }
      }
    },
    "export.photosDeletedCleanupPending": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Photos deletion succeeded. App work-file cleanup is pending; do not request Photos deletion again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "相册删除已成功，App 工作文件仍待清理；不会再次请求删除相册。" } }
      }
    },
    "export.retryPurge": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Retry App file cleanup" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重试清理 App 文件" } }
      }
    },
    "export.errorArchiveChanged": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The archive changed or failed validation. ZIP sharing and delete confirmation were reset." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "归档已变化或校验失败，ZIP 分享状态和删除确认已重置。" } }
      }
    },
    "export.errorShareIncomplete": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "ZIP sharing was cancelled or failed. Source photos remain unchanged." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "ZIP 分享已取消或失败，原照片未改变。" } }
      }
    },
    "export.errorPermission": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Full Photos Read & Write access is required. Restore access in Settings; App files are retained." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "需要完整的照片读取与写入权限。请在设置中恢复；App 文件已保留。" } }
      }
    },
    "export.errorLedger": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The frozen source-photo list is invalid. Deletion was not started; App files are retained." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "冻结的原照片清单无效。未开始删除，App 文件已保留。" } }
      }
    },
    "export.errorMissing": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A frozen source photo is missing or duplicated. Deletion was not started; App files are retained." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "有原照片缺失或重复。未开始删除，App 文件已保留。" } }
      }
    },
    "export.errorDelete": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Photos deletion was cancelled or failed. App files are retained; you may retry." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "相册删除已取消或失败。App 文件已保留，可重试。" } }
      }
    },

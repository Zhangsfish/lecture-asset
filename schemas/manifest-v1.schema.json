{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lecture-asset:manifest:1.0.0",
  "title": "Lecture Asset portable manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archive_id", "title", "created_at", "source_count", "page_count", "sort_policy", "image_policy", "pages", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "archive_id": {"type": "string", "format": "uuid"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "created_at": {"type": "string", "format": "date-time"},
    "source_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "sort_policy": {"const": "capture_time_asc_nulls_last_selection_index"},
    "image_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["codec", "max_long_edge", "jpeg_quality", "full_frame", "orientation", "upscale", "color_space"],
      "properties": {
        "codec": {"const": "jpeg"},
        "max_long_edge": {"type": "integer", "minimum": 1},
        "jpeg_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "full_frame": {"const": true},
        "orientation": {"const": "baked_up"},
        "upscale": {"const": false},
        "color_space": {"const": "sRGB"}
      }
    },
    "pages": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/page"}},
    "files": {"type": "array", "minItems": 4, "maxItems": 203, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "confidence", "bbox"],
      "properties": {
        "text": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    },
    "ocr": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "text", "blocks", "engine", "request_revision", "languages", "error_code"],
      "properties": {
        "status": {"enum": ["ok", "empty", "failed", "skipped"]},
        "text": {"type": "string"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "engine": {"const": "apple_vision"},
        "request_revision": {"type": ["integer", "null"], "minimum": 1},
        "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "error_code": {"type": ["string", "null"]}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "selection_index", "captured_at", "capture_time_source", "image", "pdf_page", "width", "height", "bytes", "sha256", "source_representation", "ocr", "warnings"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 200},
        "selection_index": {"type": "integer", "minimum": 1, "maximum": 200},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "capture_time_source": {"enum": ["photokit", "exif_with_offset", "unavailable"]},
        "image": {"type": "string", "pattern": "^slides/[0-9]{4}\\.jpg$"},
        "pdf_page": {"type": "integer", "minimum": 1, "maximum": 200},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_representation": {"enum": ["current_still", "live_photo_still"]},
        "ocr": {"$ref": "#/$defs/ocr"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(README\\.md|lecture\\.md|lecture\\.pdf|slides/[0-9]{4}\\.jpg)$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
